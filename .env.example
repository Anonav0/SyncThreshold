# Backend Server Environment Variables
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/inventory_db?retryWrites=true&w=majority

# Sales Analysis & Inventory Intelligence Config (Phase 3)
SALES_ANALYSIS_DAYS=7
STOCKOUT_WARNING_DAYS=7

# Google Gemini AI Risk Analysis Config (Phase 4)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_ENABLED=true
GEMINI_REQUEST_DELAY_MS=1500

# Automated Inventory Monitoring Config (Phase 5)
AUTOMATION_ENABLED=true
INVENTORY_CHECK_CRON=*/15 * * * *

# Email Notifications Config (Phase 7)
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Client Frontend Environment Variables
VITE_API_URL=http://localhost:5000/api
